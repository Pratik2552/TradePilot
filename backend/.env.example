# ==============================================================
# TradePilot Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# ==============================================================

# ---- Server --------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info

# ---- CORS ----------------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Engine Paths --------------------------------------------
# Absolute path to the Python engine root (parent of backtester/, strategy/, etc.)
# Leave empty to auto-detect (assumes backend/ is a sibling of the engine directories)
ENGINE_ROOT=

# ---- Results Directory ---------------------------------------
# Where the engine writes its output CSVs
# Relative to ENGINE_ROOT if not absolute
RESULTS_DIR=results

# ---- Data Cache Directory ------------------------------------
DATA_CACHE_DIR=data/cache

# ---- Default Strategy Configuration -------------------------
DEFAULT_INITIAL_CAPITAL=100000
DEFAULT_ALLOCATION=0.10
DEFAULT_MAX_POSITIONS=10
DEFAULT_STOP_LOSS_PERCENT=-15
DEFAULT_GOLDEN_CROSS_LOOKBACK=3
DEFAULT_GAP_THRESHOLD=0.50

# ---- Authentication (Future) ---------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# JWT_SECRET=your-jwt-secret
